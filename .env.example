# Copy to .env.local and fill in real values (never commit .env.local).

# Resend API key for the contact form + newsletter (https://resend.com/api-keys).
# Without it, contact submissions are logged server-side but not emailed.
RESEND_API_KEY=

# Resend Audience ID for footer newsletter signups (https://resend.com/audiences).
# Without it, newsletter signups are logged server-side but not stored.
RESEND_AUDIENCE_ID=

# See app/api/contact/route.ts for CONTACT_INBOX and FROM_ADDRESS TODOs,
# and content/contact.ts for the Calendly scheduling URL placeholder.
